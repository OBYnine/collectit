# Скопируйте этот файл в frontend/.env (или оставьте дефолты).

# Адрес backend API. По умолчанию — локальный Django на :8000
REACT_APP_API_URL=http://127.0.0.1:8000/api

# Sentry (опционально). Пустой DSN = выключено.
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_ENV=development
REACT_APP_SENTRY_TRACES_RATE=0.1

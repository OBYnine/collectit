# Скопируйте этот файл в backend/.env и заполните своими значениями.
# Файл .env НЕ коммитится в git — там реальные секреты.

# ========== Django ==========
# Сгенерируйте: python -c "import secrets; print(secrets.token_hex(32))"
DJANGO_SECRET_KEY=replace_me_with_64_random_hex_chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ========== PostgreSQL ==========
DB_NAME=collectit_db
DB_USER=collectit_user
DB_PASSWORD=collectit_pass
DB_HOST=localhost
DB_PORT=5432

# ========== СДЭК ==========
# Регистрация: https://www.cdek.ru/ru/integration
# Тестовый: https://api.edu.cdek.ru/v2 (можно оставить пустым — будет демо-режим)
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_BASE_URL=https://api.edu.cdek.ru/v2

# ========== ЮKassa ==========
# Регистрация: https://yookassa.ru/my/tst (тестовый магазин)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
FRONTEND_URL=http://127.0.0.1:3000

# ========== Email verification ==========
# В dev письма выводятся в консоль backend. Для реальной отправки укажите SMTP.
EMAIL_VERIFICATION_EXPIRE_HOURS=24
DEFAULT_FROM_EMAIL=CollectIT <no-reply@collectit.local>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_NOTIFICATIONS_ENABLED=True

# Telegram admin notifications
TELEGRAM_NOTIFICATIONS_ENABLED=True
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_REQUEST_TIMEOUT=10

# ========== AI news import ==========
# Реальный ключ храните только в backend/.env или .env.docker, не в git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
NEWS_IMPORT_SOURCE_URL=https://www.numizmatik.ru/news
NEWS_IMPORT_ENABLED=False
NEWS_IMPORT_INTERVAL_MINUTES=360
NEWS_IMPORT_LIMIT=5
NEWS_IMPORT_MAX_IMAGES=5
NEWS_IMPORT_REQUEST_TIMEOUT=60
NEWS_IMPORT_USER_AGENT=CollectITBot/1.0 (+https://localhost) Mozilla/5.0

# ========== Redis (опционально) ==========
# Без Redis: Channels на InMemory, Celery в eager-режиме (всё работает в dev)
# С Redis: REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=
REDIS_SOCKET_TIMEOUT=10

# ========== Sentry (опционально) ==========
# Регистрация: https://sentry.io (бесплатный план до 5к ошибок/мес)
SENTRY_DSN=
SENTRY_ENV=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ========== JWT cookies ==========
# Для production с https — JWT_COOKIE_SECURE=True
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
# Для SPA CSRF-cookie должна быть читаема JS, чтобы отправлять X-CSRFToken.
CSRF_COOKIE_HTTPONLY=False
ENABLE_LEGACY_JWT_ENDPOINTS=False
ENABLE_BEARER_JWT_AUTH=False
ALLOW_WEBSOCKET_QUERY_TOKEN=False
DATA_UPLOAD_MAX_MEMORY_SIZE=12582912
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
USER_IMAGE_MAX_BYTES=8388608
USER_IMAGE_MAX_COUNT=12
CHAT_MESSAGE_RATE_LIMIT_PER_MINUTE=120

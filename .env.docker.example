# Copy to .env.docker and run:
# docker compose --env-file .env.docker up --build

DJANGO_SECRET_KEY=change-me-to-a-random-64-char-secret-for-docker-dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
DJANGO_SECURE_SSL_REDIRECT=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DB_NAME=collectit_db
DB_USER=collectit_user
DB_PASSWORD=collectit_pass
POSTGRES_PORT=5433
REDIS_PORT=6380

BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
REACT_APP_API_URL=/api

JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax

CDEK_BASE_URL=https://api.edu.cdek.ru/v2
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

SENTRY_DSN=
SENTRY_ENV=development
SENTRY_TRACES_SAMPLE_RATE=0.1
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_ENV=production
REACT_APP_SENTRY_TRACES_RATE=0.1

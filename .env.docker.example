# Copy to .env.docker and run:
# docker compose --env-file .env.docker up --build

DJANGO_SECRET_KEY=change-me-to-a-random-64-char-secret-for-docker-dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
DJANGO_SECURE_SSL_REDIRECT=False
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DB_NAME=collectit_db
DB_USER=collectit_user
DB_PASSWORD=collectit_pass
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_SOCKET_TIMEOUT=10

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
REACT_APP_API_URL=/api
ENABLE_DEMO_DEPOSIT=False

EMAIL_VERIFICATION_EXPIRE_HOURS=24
DEFAULT_FROM_EMAIL=CollectIT <no-reply@collectit.local>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
EMAIL_NOTIFICATIONS_ENABLED=True

# Telegram admin notifications
TELEGRAM_NOTIFICATIONS_ENABLED=True
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_REQUEST_TIMEOUT=10

# AI news import from https://www.numizmatik.ru/news
# Do not commit real keys. Put GEMINI_API_KEY only into your local .env.docker/production secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
NEWS_IMPORT_SOURCE_URL=https://www.numizmatik.ru/news
NEWS_IMPORT_ENABLED=False
NEWS_IMPORT_INTERVAL_MINUTES=360
NEWS_IMPORT_LIMIT=5
NEWS_IMPORT_MAX_IMAGES=5
NEWS_IMPORT_REQUEST_TIMEOUT=60
NEWS_IMPORT_USER_AGENT=CollectITBot/1.0 (+https://localhost) Mozilla/5.0

JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax
CSRF_COOKIE_HTTPONLY=False
ENABLE_LEGACY_JWT_ENDPOINTS=False
ENABLE_BEARER_JWT_AUTH=False
ALLOW_WEBSOCKET_QUERY_TOKEN=False
DATA_UPLOAD_MAX_MEMORY_SIZE=12582912
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
USER_IMAGE_MAX_BYTES=8388608
USER_IMAGE_MAX_COUNT=12
CHAT_MESSAGE_RATE_LIMIT_PER_MINUTE=120

CDEK_BASE_URL=https://api.edu.cdek.ru/v2
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

SENTRY_DSN=
SENTRY_ENV=development
SENTRY_TRACES_SAMPLE_RATE=0.1
REACT_APP_SENTRY_DSN=
REACT_APP_SENTRY_ENV=production
REACT_APP_SENTRY_TRACES_RATE=0.1
